{
  "name": "deepseek-chat",
  "version": "0.1.1",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts --open",
    "backend": "node scripts/backend.mjs",
    "build": "cross-env NODE_ENV=production rspack build -c rspack.config.ts",
    "type": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --import ./tests/helpers/register-hooks.mjs --test \".test-build/tests/*.test.js\"",
    "test:backend": "node scripts/pytest.mjs",
    "lint": "oxlint src tests rspack.config.ts",
    "format": "oxfmt --write .",
    "icons": "node scripts/generate-icons.mjs",
    "scss:types": "node scripts/generate-scss-types.mjs",
    "scss:types:check": "node scripts/generate-scss-types.mjs --check",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "clsx": "2.1.1",
    "emoji-mart": "^5.6.0",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.3.3",
    "@rspack/core": "^2.3.3",
    "@rspack/dev-server": "^2.2.2",
    "@swc/helpers": "0.5.23",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/node": "~20.9.2",
    "@types/prismjs": "^1.26.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "oxfmt": "0.48.0",
    "oxlint": "^1.94.0",
    "sass-embedded": "^1.108.2",
    "sass-loader": "^17.1.0",
    "typescript": "7.0.2"
  }
}
